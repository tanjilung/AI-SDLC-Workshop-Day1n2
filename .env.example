JWT_SECRET=replace-with-a-long-random-secret
RP_ID=localhost
RP_NAME=Todo App
RP_ORIGIN=http://localhost:3000

# Database connection URL (Postgres)
# Example: postgres://username:password@localhost:5432/todos
# This repository's server code uses DATABASE_URL (drizzle + pg).
DATABASE_URL=postgres://user:password@localhost:5432/todos

# Cookie security setting:
# Set to "true" only if your deployment uses a valid HTTPS certificate.
# For HTTP or self-signed certificates (e.g., DuckDNS, local dev), keep it "false".
COOKIE_SECURE=false
